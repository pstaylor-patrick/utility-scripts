# docker-kill ignore list
#
# Resources matching these patterns are left untouched by docker-kill.sh.
# Each non-empty, non-comment line is an extended regular expression (ERE)
# matched against the resource name (or repository:tag for images).
# Sections: [containers], [images], [volumes], [networks].
# Override this file's path with the DOCKER_KILL_IGNORE_FILE env var.

[containers]
# Shared dockerized Caddy edge fronting local-dev hostnames.
^dev-caddy$
# cove: Postgres + app, compose project "cove".
^cove-(app|db)-[0-9]+$

[images]
# Keep the Caddy image the kept container runs on. It is digest-pinned, so its
# local tag shows as <none>; match the repository rather than a tag.
^caddy:
# cove: app image is built locally; db uses pgvector.
^cove-app:
^pgvector/pgvector:

[volumes]
^dev-caddy_config$
^dev-caddy_data$
# cove Postgres data. Compose prefixes the project name, so the real volume is
# cove_cove-pgdata, not cove-pgdata.
^cove_cove-pgdata$

[networks]
^cove_default$
# journey-to-jericho: external edge network joining the shared dev-caddy.
# Certs live in dev-caddy_data; this net has no state of its own, kept only so
# the stack can rejoin dev-caddy without recreating it.
^j2j-edge$
# league-os: external edge network joining the shared dev-caddy. Same reasoning
# as j2j-edge above.
^leagueos-edge$
